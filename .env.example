# Copy to .env (never commit .env) and export before running locally:
#   set -a; source .env; set +a
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Optional: only needed if your org requires the numeric project number for Document AI
# GOOGLE_CLOUD_PROJECT_NUMBER=123456789012

ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=change-me
# Secret Manager secret that Cloud Run reads the AlloyDB password from (deploy_cloud_run.py)
ALLOYDB_PASSWORD_SECRET=alloydb-password

# Optional tuning
# THINKING_BUDGET=1024
# STATE_CACHE_TTL_S=60
# CONTEXT_CACHE_TTL_S=300
